modules = ["python-3.12", "vue-node-20", "nodejs-20", "bash", "web"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["cargo", "gitFull", "glibcLocales", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend-imports"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend-syntax"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "frontend-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend-pytest"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && pnpm approve-builds --yes 2>/dev/null; pnpm dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && python3 -m uvicorn app.main:app --host localhost --port 8000"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "backend-imports"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && python3 -c \"import sys; sys.path.insert(0, '.'); [__import__(m) for m in ['app.core.config','app.domain.services.agents.planner','app.domain.services.agents.execution','app.domain.services.flows.plan_act','app.domain.services.agent_task_runner','app.domain.services.agent_domain_service','app.domain.services.prompts.system','app.domain.services.prompts.execution','app.domain.services.prompts.planner']]; print('PASSED')\""

[[workflows.workflow]]
name = "backend-syntax"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && python3 -c \"import ast, os; [ast.parse(open(os.path.join(r,f)).read()) for r,d,fs in os.walk('app') if '__pycache__' not in r for f in fs if f.endswith('.py')]; print('PASSED')\""

[[workflows.workflow]]
name = "frontend-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npx vue-tsc --noEmit 2>&1 | tail -20 && echo 'PASSED'"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "backend-pytest"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && python3 -m pytest tests/ -x -q 2>&1 | tail -20"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8000
externalPort = 8000
exposeLocalhost = true

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "cd frontend && pnpm install --frozen-lockfile && pnpm build"]
run = ["bash", "-c", "bash /home/runner/workspace/scripts/start_production.sh"]

[userenv]

